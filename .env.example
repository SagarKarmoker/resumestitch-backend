# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# JWT Secret (for authentication)
JWT_SECRET=your-jwt-secret

# S3-Compatible Storage
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_RESUMES=resumes
S3_BUCKET_OUTPUTS=outputs

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
